<!-- Dark appearance. Only brushes; the control styles live in Themes/Controls.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="UiBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="UiSurfaceBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="UiCanvasBrush" Color="#111111" />
    <SolidColorBrush x:Key="UiForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="UiMutedForegroundBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="UiMessageBrush" Color="#FF9494" />
    <SolidColorBrush x:Key="UiControlBackgroundBrush" Color="#3A3A3D" />
    <SolidColorBrush x:Key="UiControlBorderBrush" Color="#5A5A5E" />
    <SolidColorBrush x:Key="UiControlHoverBrush" Color="#4A4A4F" />
    <SolidColorBrush x:Key="UiControlPressedBrush" Color="#2A2A2D" />
</ResourceDictionary>
