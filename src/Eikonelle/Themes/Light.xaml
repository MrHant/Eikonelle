<!-- Light appearance. Only brushes; the control styles live in Themes/Controls.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="UiBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="UiSurfaceBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="UiCanvasBrush" Color="#CFCFCF" />
    <SolidColorBrush x:Key="UiForegroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="UiMutedForegroundBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="UiMessageBrush" Color="#A31515" />
    <SolidColorBrush x:Key="UiControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UiControlBorderBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="UiControlHoverBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="UiControlPressedBrush" Color="#DADADA" />
    <SolidColorBrush x:Key="UiSelectionBorderBrush" Color="#D13438" />
    <SolidColorBrush x:Key="UiSelectionFillBrush" Color="#220078D7" />
</ResourceDictionary>
