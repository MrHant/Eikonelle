<Window x:Class="Eikonelle.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Eikonelle"
        Title="Screenshot preview" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <DockPanel>
        <local:AppMenuBar x:Name="Menu" DockPanel.Dock="Top" />
        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
    </DockPanel>
</Window>
