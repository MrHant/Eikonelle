<Window x:Class="Eikonelle.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot preview" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="#2D2D30">
            <Button x:Name="OpenEditorButton"
                    Click="OpenEditor_Click"
                    ToolTip="Open editor"
                    IsEnabled="False"
                    FontSize="18"
                    Padding="10,2">&#x270E;</Button>
        </ToolBar>
        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
    </DockPanel>
</Window>
