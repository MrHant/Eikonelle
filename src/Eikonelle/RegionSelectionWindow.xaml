<Window x:Class="Eikonelle.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select region" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Cursor="Cross" Background="{DynamicResource UiCanvasBrush}">
    <Grid MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
          MouseMove="Overlay_MouseMove"
          MouseLeftButtonUp="Overlay_MouseLeftButtonUp">
        <Image x:Name="ScreenImage" Stretch="Fill" />
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                       Stroke="{DynamicResource UiSelectionBorderBrush}" StrokeThickness="2"
                       Fill="{DynamicResource UiSelectionFillBrush}" />
        </Canvas>
    </Grid>
</Window>
