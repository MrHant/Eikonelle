<Window x:Class="Eikonelle.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Eikonelle"
        Title="Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <local:MainMenu DockPanel.Dock="Top" />
        <StackPanel Margin="20">
            <Label Content="Screenshot _hotkey" Target="{Binding ElementName=HotkeyInput}" Padding="0,0,0,8" />
            <TextBox x:Name="HotkeyInput" IsReadOnly="True" Padding="8"
                     PreviewKeyDown="HotkeyInput_PreviewKeyDown" />
            <TextBlock Text="Click the field and press a key combination. Tab moves to the buttons."
                       TextWrapping="Wrap" Margin="0,8,0,16" />
            <TextBlock Text="Capture mode" Padding="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="FullScreenOption" Content="_Full Screen" GroupName="CaptureMode"
                             Checked="CaptureMode_Checked" Margin="0,0,16,0" />
                <RadioButton x:Name="RegionOption" Content="_Region" GroupName="CaptureMode"
                             Checked="CaptureMode_Checked" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Click="Apply_Click" MinWidth="80" Padding="8,4" Margin="0,0,8,0" />
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="80" Padding="8,4" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
